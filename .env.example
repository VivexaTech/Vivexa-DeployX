# =============================================================================
# Vivexa DeployX — environment variables
# Copy to .env.local for local development. Never commit real values.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# Everything else is server-only and must never be exposed to the client.
# Any integration left blank runs in "Development Mode": the UI explains what
# is missing and no external operation is simulated as successful.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL (no trailing slash). Used for auth redirects, OAuth callbacks,
# canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Auth + Postgres) — https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe for the browser; access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Used for trusted writes after authorization checks.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Encryption — SERVER ONLY
# -----------------------------------------------------------------------------
# 32-byte key (base64) used to encrypt GitHub tokens and environment variable
# values at rest (AES-256-GCM). Generate with: openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes previously stored secrets unreadable.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# GitHub OAuth App — https://github.com/settings/developers
# -----------------------------------------------------------------------------
# Authorization callback URL must be: {NEXT_PUBLIC_APP_URL}/api/github/callback
GITHUB_CLIENT_ID=
# SERVER ONLY.
GITHUB_CLIENT_SECRET=
# Optional override of the callback URL (defaults to NEXT_PUBLIC_APP_URL + /api/github/callback).
GITHUB_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Vercel (deployment infrastructure) — https://vercel.com/account/tokens
# -----------------------------------------------------------------------------
# SERVER ONLY. Token with access to the team/account that will own deployments.
VERCEL_TOKEN=
# Optional team ID (team_xxx) if deployments should live under a team.
VERCEL_TEAM_ID=
# Prefix for provider project names, e.g. "deployx" -> deployx-my-app.
VERCEL_PROJECT_PREFIX=deployx
# Optional. Secret configured on a Vercel webhook pointing at /api/webhooks/vercel
# for faster status updates. Without it, statuses are refreshed by polling.
VERCEL_WEBHOOK_SECRET=

# Base domain for free project subdomains (myproject.<base>). The domain must be
# added to the Vercel account/team above with wildcard DNS configured.
DEPLOYX_SUBDOMAIN_BASE=deployx.vivexatech.in

# -----------------------------------------------------------------------------
# Razorpay — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# -----------------------------------------------------------------------------
# Key ID is sent to the browser for Checkout; it is not a secret.
RAZORPAY_KEY_ID=
# SERVER ONLY. Used to create orders and verify checkout signatures.
RAZORPAY_KEY_SECRET=
# SERVER ONLY. Secret of the webhook pointing at /api/webhooks/razorpay
# (events: payment.captured, payment.failed, order.paid, refund.created, refund.processed).
RAZORPAY_WEBHOOK_SECRET=
