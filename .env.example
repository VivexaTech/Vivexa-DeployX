# Application
# Local development: http://localhost:3000
# Vercel Production: https://deployx.vivexatech.in  (set for Production, not only Development)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAIN_DOMAIN=vivexatech.in
NEXT_PUBLIC_MAIN_DOMAIN=vivexatech.in
APP_ENCRYPTION_KEY=replace-with-32-char-random-secret
CRON_SECRET=replace-with-long-random-cron-secret
ADMIN_UIDS=firebaseUidOne,firebaseUidTwo

# Firebase client (safe to expose — set these in Vercel Production too)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Authentication → Settings → Authorized domains must include:
# localhost, 127.0.0.1, and deployx.vivexatech.in
# Authentication → Sign-in method must have Google enabled.

# Firebase Admin (server only — never prefix with NEXT_PUBLIC_)
# Required in Vercel → Settings → Environment Variables → Production:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste as ONE line. Keep the \n sequences. Wrap in double quotes.
# Aliases also accepted: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional if the PEM keeps breaking on Vercel:
# FIREBASE_ADMIN_PRIVATE_KEY_BASE64=

# GitHub OAuth (server only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Vercel API (server only)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=DeployX <deployx@your-verified-domain>
RESEND_FROM_NAME=Vivexa DeployX
